{
  "entryPoints": [
    "src/components",
    "src/hooks/*.types.ts",
    "src/config/writeQueue.types.ts",
    "src/config/audioProgress.types.ts",
    "src/fables/fables.types.ts",
    "src/config/childProfiles.types.ts",
    "src/contexts/ChildProfilesContext.types.ts",
    "src/config/childPolicy.types.ts"
  ],
  "out": "docs",
  "entryPointStrategy": "expand",
  "includeVersion": true,
  "excludeExternals": true,
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeInternal": false,
  "treatWarningsAsErrors": false,
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "exclude": [
    "src/components/**/*.styled.ts",
    "src/components/**/*.tsx",
    "src/components/**/*.stories.ts",
    "src/components/**/index.ts",
    "src/components/**/*.hook.ts"
  ],
  "cleanOutputDir": false
}
